# Copy this file to .env at the repository root. Do not commit .env.
# A DNS hostname resolving to your host; no scheme or trailing slash.
SITE_ADDRESS=wahi.example.org
ROUTING_URL=
# Optional HTTPS receiver implementing the signed WAHI webhook contract.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
ALERT_ESCALATION_MINUTES=10
