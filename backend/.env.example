DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_ambulance
DB_USER=postgres
DB_PASSWORD=replace-me
PORT=5000
# Optional private OSRM-compatible routing service, e.g. http://localhost:5001
ROUTING_URL=
# Run `npm run worker` alongside the API for retries and automatic escalation.
NOTIFICATION_WEBHOOK_URL=
# At least 32 characters when a webhook URL is configured.
NOTIFICATION_WEBHOOK_SECRET=
ALERT_ESCALATION_MINUTES=10
UI_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Enable only behind your trusted single reverse proxy.
TRUST_PROXY=0
ACCESS_LOG=false
DB_POOL_SIZE=10
# Optional: DB_PASSWORD_FILE, DB_SSL_CA_FILE for a remote verified TLS database.
